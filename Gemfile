source "https://rubygems.org"

# Usa exactamente las versiones de Jekyll y plugins que GitHub Pages
# usa en producción, así "funciona en local" == "funciona en GH Pages".
gem "github-pages", group: :jekyll_plugins

# Requerido para servir en local con Ruby >= 3.0 (ya no viene por defecto).
gem "webrick", "~> 1.8"
